# clv-engine — PAPER ONLY. Copy to .env and edit. Never commit .env.
# Comments go on their own lines: systemd EnvironmentFile and docker env_file keep
# anything after "=" verbatim, so an inline "# note" would become part of the value.
# No wallet keys, no exchange API keys: the engine only reads public market data.

# --- storage ---
DB_PATH=./data/clv.sqlite
REPORT_DIR=./reports
REPORT_TZ=America/Mexico_City
# 0=Mon..6=Sun, -1 disables the auto weekly report
WEEKLY_REPORT_WEEKDAY=0
WEEKLY_REPORT_HOUR=9

# --- scope ---
# Priority order: high-volume markets first. nfl = NFL moneyline (Polymarket series 12185, Kalshi KXNFLGAME).
LEAGUES=nba,nfl,epl,laliga,ligamx,ucl
# TEMPORARY scope cut: no NEW entries in these leagues / venues (existing ledger rows still get close + settlement).
# Venues are still polled for arbs and venue CLV; to re-enable, empty the list (EXCLUDED_VENUES=).
EXCLUDED_LEAGUES=ucl
EXCLUDED_VENUES=kalshi
# venue polling (Polymarket + Kalshi, public, free)
POLL_SECONDS=120
# only games kicking off within this window
LOOKAHEAD_HOURS=72
# cross-venue kickoff tolerance (Kalshi has no exact kickoff field)
MATCH_WINDOW_HOURS=30

# --- sharp reference (Pinnacle via The Odds API) ---
# none | theoddsapi (alias: pinnacle)
SHARP_SOURCE=none
# leave empty until the plan is paid; CLV stays "pending_sharp"
ODDS_API_KEY=
SHARP_BOOK=pinnacle
# Odds API keys; no Caliente / Codere MX on The Odds API
SOFT_BOOKS=codere_it,betsson,williamhill,unibet_eu
# multiplicative | power | shin
DEVIG_METHOD=power
# --- Odds API credit scheduler (free plan: 500 credits per CALENDAR month; see README "Credit budget") ---
# plan size and the local hard cap (never spend past it). The x-requests-remaining/used/last headers are the truth.
ODDS_API_MONTHLY_BUDGET=500
ODDS_API_HARD_CAP=450
# regions sent with bookmakers=pinnacle (bookmakers overrides regions; 1 market x 1 region = 1 credit per call)
ODDS_API_REGIONS=eu
# polls happen between T-CLOSE_WINDOW_MAX_MINUTES and T-CLOSE_WINDOW_MIN_MINUTES of a kickoff round (kickoffs of one sport
# inside that span share one poll)
CLOSE_WINDOW_MAX_MINUTES=5
CLOSE_WINDOW_MIN_MINUTES=1
# 1 = one final close poll per round; 2 = also an early one at the start of the window
CLOSE_POLLS_PER_ROUND=1
# one entry poll per round this many minutes before its first kickoff (>= MAX_SHARP_AGE_MINUTES + CLOSE_WINDOW_MAX_MINUTES)
ENTRY_POLL_LEAD_MINUTES=25
# daily allowance = spendable credits / days left in the month, at most this multiple of the even share of the hard cap
ODDS_API_DAILY_BURST=3
# share of the daily allowance reserved for close polls (entry polls may only use the rest)
ODDS_API_CLOSE_RESERVE=0.50
# below this provider-reported x-requests-remaining only close polls run
ODDS_API_MIN_REMAINING=100
# 0 = derive from books (1 market x ceil(books/10) regions); the x-requests-last header overrides it per call
ODDS_API_CREDITS_PER_CALL=0
# Pinnacle data older than this is not used for entries or closing capture (budget exhausted, outage)
MAX_SHARP_AGE_MINUTES=20
# a Pinnacle close only counts when sampled within this many minutes before kickoff (0 disables)
CLOSE_MAX_AGE_MINUTES=20
# planning estimate only: kickoff rounds per league per day
PLAN_ROUNDS_PER_LEAGUE_DAY=2
# 1 = backfill missing closes from the historical endpoint (paid, extra credits)
ODDS_API_HISTORICAL=0

# --- paper entry rule ---
# auto (pinnacle, else cross-venue consensus) | sharp | consensus
ENTRY_REFERENCE=auto
# enter when Pinnacle no-vig fair / (price incl. fee) - 1 >= MIN_EDGE (0.05 = 5% after fees; proposal)
MIN_EDGE=0.05
# 1 = only Pinnacle may justify an entry (no consensus fallback); needs a working ODDS_API_KEY
REQUIRE_PINNACLE_REF=1
# minimum resting ask depth in USD within DEPTH_TOLERANCE of the best ask (0 disables); STAKE_USD must also fill in full
MIN_DEPTH_USD=250
DEPTH_TOLERANCE=0.01
# simulated notional per entry, filled against real book depth
STAKE_USD=100
ALLOW_PARTIAL=0
# 1 lets a game hold opposite bets (e.g. YES on one venue and NO on the other): they hedge each other
ALLOW_HEDGED_ENTRIES=0
MAX_ENTRIES_PER_OUTCOME=1
MIN_MINUTES_BEFORE_START=5
ENTRY_SIDES=yes,no
# skip asks below 5c / above 95c (longshot noise)
MIN_PRICE=0.05
MAX_PRICE=0.95
# also paper-bet soft books when they beat Pinnacle fair (adds the SOFT_BOOKS to the /odds request; default 0 = Pinnacle only)
SOFT_ENTRIES=0
SOFT_EDGE=0.03
# cent (non-direct member) | micro
KALSHI_FEE_ROUNDING=cent
FETCH_NO_BOOKS=1

# --- arbitrage scanner ---
ARB_MIN_PROFIT_USD=1.0
ARB_MIN_ROI=0.005
ARB_MAX_SHARES=2000

# --- alerts ---
# stdout,file (webhook and telegram turn on by themselves when their secrets below are set)
ALERT_SINKS=stdout,file
ALERT_FILE=./data/alerts.jsonl
# Slack/Discord incoming webhook (secret, env only)
ALERT_WEBHOOK_URL=
# slack | discord | generic
ALERT_WEBHOOK_KIND=slack
# Telegram: the sink is on only when BOTH are set. Bot token from @BotFather (secret, env only).
TELEGRAM_BOT_TOKEN=
# chat that receives alerts: a user id, or a group/channel id such as -100...
TELEGRAM_CHAT_ID=
ALERT_COOLDOWN_SECONDS=1800

# --- graduation gate (proposed thresholds for Julio to approve; reporting only, see docs/GRADUATION.md) ---
GRAD_MIN_GAMES=300
GRAD_CI_LEVEL=0.90
GRAD_MIN_GROUP_GAMES=30
GRAD_MIN_LEAGUES=2
GRAD_MIN_VENUES=2
GRAD_MAX_LEAGUE_SHARE=0.70
GRAD_MIN_SETTLED_FRACTION=0.90
GRAD_BOOTSTRAP_SAMPLES=5000
GRAD_DEADLINE=2027-01-27

SNAPSHOT_MIN_SECONDS=600
SETTLE_AFTER_HOURS=3
LOG_LEVEL=INFO
