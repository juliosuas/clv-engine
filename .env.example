# clv-engine — PAPER ONLY. Copy to .env and edit. Never commit .env.
# No wallet keys, no exchange API keys: the engine only reads public market data.

# --- storage ---
DB_PATH=./data/clv.sqlite
REPORT_DIR=./reports
REPORT_TZ=America/Mexico_City
WEEKLY_REPORT_WEEKDAY=0          # 0=Mon..6=Sun, -1 disables the auto weekly report
WEEKLY_REPORT_HOUR=9

# --- scope ---
LEAGUES=ligamx,epl,laliga,ucl,nba
POLL_SECONDS=120                 # venue polling (Polymarket + Kalshi, public, free)
LOOKAHEAD_HOURS=72               # only games kicking off within this window
MATCH_WINDOW_HOURS=30            # cross-venue kickoff tolerance (Kalshi has no exact kickoff field)

# --- sharp reference (Pinnacle via The Odds API) ---
SHARP_SOURCE=none                # none | theoddsapi
ODDS_API_KEY=                    # leave empty until the plan is paid; CLV stays "pending_sharp"
SHARP_BOOK=pinnacle
SOFT_BOOKS=codere_it,betsson,williamhill,unibet_eu   # Odds API keys; no Caliente / Codere MX on The Odds API
DEVIG_METHOD=power               # multiplicative | power | shin
SHARP_POLL_SECONDS=900           # ~96 calls/day per league at 15 min
SHARP_CLOSE_POLL_SECONDS=120     # faster polling inside CLOSE_CAPTURE_MINUTES of kickoff
CLOSE_CAPTURE_MINUTES=30
ODDS_API_HISTORICAL=0            # 1 = backfill missing closes from the historical endpoint (paid, extra credits)

# --- paper entry rule ---
ENTRY_REFERENCE=auto             # auto (pinnacle, else cross-venue consensus) | sharp | consensus
MIN_EDGE=0.02                    # enter when fair / (price incl. fee) - 1 >= MIN_EDGE
STAKE_USD=100                    # simulated notional per entry, filled against real book depth
ALLOW_PARTIAL=0
MAX_ENTRIES_PER_OUTCOME=1
MIN_MINUTES_BEFORE_START=5
ENTRY_SIDES=yes,no
MIN_PRICE=0.05                   # skip asks below 5c / above 95c (longshot noise)
MAX_PRICE=0.95
SOFT_ENTRIES=1                   # also paper-bet soft books when they beat Pinnacle fair
SOFT_EDGE=0.03
KALSHI_FEE_ROUNDING=cent         # cent (non-direct member) | micro
FETCH_NO_BOOKS=1

# --- arbitrage scanner ---
ARB_MIN_PROFIT_USD=1.0
ARB_MIN_ROI=0.005
ARB_MAX_SHARES=2000

# --- alerts ---
ALERT_SINKS=stdout,file          # stdout,file,webhook,telegram
ALERT_FILE=./data/alerts.jsonl
ALERT_WEBHOOK_URL=               # Slack/Discord incoming webhook (secret, env only)
ALERT_WEBHOOK_KIND=slack         # slack | discord | generic
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_COOLDOWN_SECONDS=1800

SNAPSHOT_MIN_SECONDS=600
SETTLE_AFTER_HOURS=3
LOG_LEVEL=INFO
